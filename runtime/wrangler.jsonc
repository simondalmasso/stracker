{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stracker-zero-cost-runtime-poc",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/points"]
  },
  "d1_databases": [
    {
      "binding": "SESSION_DB",
      "database_name": "stracker-session-poc-placeholder",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://example.cloudflareaccess.com",
    "ACCESS_AUD": "NON_PRODUCTION_PLACEHOLDER"
  }
}
