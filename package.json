{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.3.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "build:export": "bash scripts/build-mobile-export.sh",
    "start": "bun .next/standalone/server.js",
    "lint": "eslint src/app/page.tsx src/app/layout.tsx src/components/mobile src/lib/location-source gateway/src",
    "typecheck": "tsc --noEmit",
    "test:backend": "python -m unittest discover -s tests -p 'test_*.py'",
    "test:gateway": "node --test gateway/tests/gateway.test.mjs",
    "test:access-jwt": "node --test gateway/tests/access-jwt.test.mjs",
    "test:gateway-e2e": "node --test gateway/tests/mock-e2e.test.mjs",
    "test:gateway-invariants": "node tests/gateway_product_invariants.mjs",
    "test:vector-map": "bun test tests/vector-map",
    "test:native-sharing-cloudflare:vitest": "vitest run --config native-sharing-cloudflare/vitest.config.mts",
    "gateway:syntax": "node --check gateway/src/access-jwt.mjs && node --check gateway/src/policy.mjs && node --check gateway/src/index.mjs",
    "gateway:wrangler-dry-run": "bunx wrangler@4.111.0 versions upload --dry-run --config gateway/wrangler.jsonc --outdir /tmp/stracker-gateway-dist",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
