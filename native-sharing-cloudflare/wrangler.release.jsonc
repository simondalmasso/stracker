{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stracker",
  "main": "src/minimal-worker.ts",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/share/*", "/shared", "/shared/*", "/__stracker/build.json"]
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  }
}
