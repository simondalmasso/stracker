{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stracker",
  "main": "src/minimal-worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/share/*", "/shared", "/shared/*", "/__stracker/build.json"]
  },
  "observability": {
    "enabled": false
  },
  "dependencies_instrumentation": {
    "enabled": false
  }
}
