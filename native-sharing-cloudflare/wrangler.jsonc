{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stracker-native-sharing-runtime-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/share/*", "/api/cookie-sessions", "/api/cookie-sessions/*", "/shared", "/shared/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NATIVE_SHARING",
        "class_name": "NativeSharingDurableObject"
      }
    ]
  },
  "exports": {
    "NativeSharingDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false
  }
}
