{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stracker-native-sharing-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "durable_objects": {
    "bindings": [
      {
        "name": "NATIVE_SHARING",
        "class_name": "NativeSharingDurableObject"
      }
    ]
  },
  "exports": {
    "NativeSharingDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  }
}
