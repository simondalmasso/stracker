{
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/share/*", "/api/cookie-sessions", "/api/cookie-sessions/*", "/shared", "/shared/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "NATIVE_SHARING", "class_name": "NativeSharingDurableObject" }
    ]
  },
  "exports": {
    "NativeSharingDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
